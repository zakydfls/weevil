# ─── Backend (apps/backend/.env) ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=weevil
API_PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weevil

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_RECORDINGS=weevil-recordings
PUBLIC_ASSET_URL=

# Frontend URL used for invitation links sent by email
WEB_APP_URL=http://localhost:3000
AUTH_OTP_SECRET=dev-only-change-me-to-at-least-32-characters

# Century Notification Gateway (century-notif)
NOTIFICATION_GATEWAY_URL=http://localhost:9111
NOTIFICATION_GATEWAY_API_KEY=
NOTIFICATION_GATEWAY_TIMEOUT_MS=5000

# ─── Web (apps/web/.env.local) ────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

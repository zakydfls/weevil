{
  "name": "@weevil/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Weevil backend services",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api && nest build worker",
    "start:api": "nest start api",
    "dev:api": "nest start api --watch",
    "start:worker": "nest start worker",
    "dev:worker": "nest start worker --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs,prisma}/**/*.{ts,js,json,md,prisma}\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/weevil} prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.ts",
    "prisma:seed:prod": "ts-node --transpile-only -r tsconfig-paths/register prisma/seed.prod.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "amqplib": "^0.10.8",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "minio": "^8.0.5",
    "nanoid": "^5.1.5",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "prisma": "7.8.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "packageManager": "pnpm@10.33.2"
}

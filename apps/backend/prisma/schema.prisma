generator client {
  provider = "prisma-client"
  output   = "../libs/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Workspace-scoped membership role.
/// `OWNER` is the per-tenant super-admin (one or more per workspace).
/// `ADMIN` can manage members, projects, billing.
/// `MEMBER` can create + manage their own captures + comment.
/// `VIEWER` is read-only on captures & comments.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Lifecycle of a workspace membership.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Platform-level role (across all tenants). Reserved for Weevil operators.
enum PlatformRole {
  USER
  SUPPORT
  PLATFORM_ADMIN
}

/// Granular permission keys. Used in WorkspaceMember.extraPermissions / deniedPermissions
/// for per-user overrides on top of the role's defaults.
enum Permission {
  // Workspace administration
  WORKSPACE_VIEW
  WORKSPACE_UPDATE
  WORKSPACE_DELETE
  WORKSPACE_BILLING
  // Members
  MEMBER_INVITE
  MEMBER_REMOVE
  MEMBER_ROLE_UPDATE
  // Projects
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_DELETE
  // Reports / captures
  REPORT_CREATE
  REPORT_READ_ALL
  REPORT_READ_OWN
  REPORT_UPDATE_ANY
  REPORT_UPDATE_OWN
  REPORT_DELETE_ANY
  REPORT_DELETE_OWN
  REPORT_SHARE
  // Comments
  COMMENT_CREATE
  COMMENT_DELETE_ANY
  COMMENT_DELETE_OWN
  // Integrations / API tokens
  API_TOKEN_MANAGE
  INTEGRATION_MANAGE
  // Board (Kanban)
  BOARD_MANAGE
}

enum ReportSource {
  EXTENSION
  DASHBOARD
  API
}

enum ReportStatus {
  DRAFT
  UPLOADING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum UploadKind {
  SCREEN_RECORDING
  CONSOLE_LOGS
  NETWORK_LOGS
  SCREENSHOT
  DOM_SNAPSHOT
  HAR
  OTHER
}

enum UploadStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum ReportEventKind {
  REPORT_CREATED
  UPLOAD_CREATED
  UPLOAD_COMPLETED
  PROCESSING_STARTED
  PROCESSING_COMPLETED
  PROCESSING_FAILED
  CONSOLE_LOGS_ATTACHED
  NETWORK_LOGS_ATTACHED
  CAPTURE_SESSION_STARTED
  CAPTURE_SESSION_COMPLETED
  ACTIONS_ATTACHED
  RUNTIME_ERRORS_ATTACHED
  PERFORMANCE_ENTRIES_ATTACHED
  DOM_EVENTS_ATTACHED
  BACKEND_TRACES_ATTACHED
}

enum ConsoleLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum CaptureSessionStatus {
  STARTED
  PAUSED
  COMPLETED
  FAILED
}

enum PageActionKind {
  CLICK
  DOUBLE_CLICK
  INPUT
  KEY_PRESS
  SCROLL
  HOVER
  FORM_SUBMIT
  NAVIGATION
  ROUTE_CHANGE
  VISIBILITY_CHANGE
  CUSTOM
}

enum RuntimeErrorKind {
  JS_ERROR
  UNHANDLED_REJECTION
  RESOURCE_ERROR
  CSP_VIOLATION
  CUSTOM
}

enum PerformanceEntryKind {
  NAVIGATION
  RESOURCE
  PAINT
  MARK
  MEASURE
  WEB_VITAL
  MEMORY
  LONG_TASK
  CUSTOM
}

enum DomEventKind {
  SNAPSHOT
  MUTATION
  SELECTION
  FOCUS
  BLUR
  CUSTOM
}

enum BackendTraceStatus {
  OK
  ERROR
  UNKNOWN
}

enum OtpPurpose {
  SIGNUP
}

model Workspace {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  status    WorkspaceStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  projects     Project[]
  reports      BugReport[]
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  sessions     AuthSession[]
  apiTokens    ApiToken[]
  reportAssignees ReportAssignee[]
  reportBoardColumns ReportBoardColumn[]
  notificationPreferences UserNotificationPreference[]
  inAppNotifications InAppNotification[]
  /// Users who have selected this workspace as their default.
  defaultedBy  User[]            @relation("UserDefaultWorkspace")

  @@map("workspaces")
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  key         String
  name        String
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports   BugReport[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("projects")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  displayName   String?
  avatarUrl     String?
  /// Hashed password (argon2id). Null for OAuth-only accounts.
  passwordHash  String?
  /// Platform-level role. 99% of users are USER; reserved for Weevil ops staff.
  platformRole  PlatformRole @default(USER)
  status        UserStatus   @default(ACTIVE)
  /// Last workspace the user opened — used for cold-start tenant switching.
  defaultWorkspaceId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  defaultWorkspace Workspace?         @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)
  memberships      WorkspaceMember[]
  sessions         AuthSession[]
  invitesCreated   WorkspaceInvite[]  @relation("InviteCreator")
  reports          BugReport[]
  apiTokens        ApiToken[]
  assignedReports  ReportAssignee[]
  reportAssignmentsCreated ReportAssignee[] @relation("ReportAssigner")
  notificationPreferences UserNotificationPreference[]
  inAppNotifications InAppNotification[]

  @@index([status])
  @@map("users")
}

/// Generic OTP challenge. Purpose + recipient make this reusable for signup,
/// password reset, email change, and future auth challenges. Raw OTP codes are
/// never stored; purpose-specific data lives in payload.
model OtpChallenge {
  id            String     @id @default(cuid())
  purpose       OtpPurpose
  recipient     String
  codeHash      String
  payload       Json?
  attemptCount  Int        @default(0)
  resendCount   Int        @default(0)
  expiresAt     DateTime
  nextResendAt  DateTime
  lastSentAt    DateTime   @default(now())
  consumedAt    DateTime?
  lockedAt      DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([purpose, recipient])
  @@index([purpose, expiresAt])
  @@index([consumedAt])
  @@map("otp_challenges")
}

/// Junction table — a user can belong to multiple workspaces with distinct roles.
/// This is the foundation of multi-tenancy: every workspace-scoped query joins through here.
model WorkspaceMember {
  id                 String           @id @default(cuid())
  workspaceId        String
  userId             String
  role               WorkspaceRole    @default(MEMBER)
  status             MembershipStatus @default(ACTIVE)
  /// Permissions granted on top of the role's defaults.
  extraPermissions   Permission[]
  /// Permissions explicitly revoked from this member, overriding the role.
  deniedPermissions  Permission[]
  invitedById        String?
  joinedAt           DateTime?
  lastActiveAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, role, status])
  @@map("workspace_members")
}

/// Per-user notification preferences inside one workspace. Features default off
/// until the user explicitly enables them from Settings.
model UserNotificationPreference {
  id                 String   @id @default(cuid())
  workspaceId        String
  userId             String
  emailOnNewCapture  Boolean  @default(false)
  emailOnNewComment  Boolean  @default(false)
  emailOnAssignment  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("user_notification_preferences")
}

/// User-facing notifications shown in the product navbar. These are separate
/// from outbound email delivery and are safe to create from any domain event.
model InAppNotification {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String
  type        String
  title       String
  body        String?
  actionUrl   String?
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@map("in_app_notifications")
}

/// Pending workspace invitations. Anyone with the token can accept (then becomes a member).
model WorkspaceInvite {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  token       String           @unique
  status      MembershipStatus @default(INVITED)
  createdById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([token])
  @@map("workspace_invites")
}

/// Session = opaque bearer token (httpOnly cookie on the web, header on the extension/API).
/// Rotation: a new session is issued on login; long-lived rotation extends expiresAt.
model AuthSession {
  id            String   @id @default(cuid())
  userId        String
  /// SHA-256 of the bearer token. Never store the raw token.
  tokenHash     String   @unique
  /// Optional active workspace for this session — saves a join on every request.
  workspaceId   String?
  userAgent     String?
  ipAddress     String?
  lastUsedAt    DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

/// Scoped programmatic-access token (for CI, integrations, extension headless mode).
model ApiToken {
  id            String   @id @default(cuid())
  workspaceId   String
  createdById   String
  name          String
  /// SHA-256 of the raw token. Display the raw token to the user exactly once at creation.
  tokenHash     String   @unique
  /// Permissions granted to this token. Subset of the creator's effective permissions.
  permissions   Permission[]
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@map("api_tokens")
}

model BugReport {
  id             String       @id @default(cuid())
  workspaceId    String
  projectId      String
  createdById    String?
  title          String
  description    String?
  status         ReportStatus @default(DRAFT)
  source         ReportSource @default(EXTENSION)
  shareToken     String       @unique
  /// Capability token returned only at capture creation time. The extension
  /// uses this for upload/telemetry writes without exposing it in report detail.
  ingestToken    String?      @unique
  pageUrl        String?
  userAgent      String?
  browserName    String?
  browserVersion String?
  osName         String?
  viewportWidth  Int?
  viewportHeight Int?
  boardColumn    String       @default("backlog")
  boardOrder     Int?
  metadata       Json?
  failureReason  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  uploads         ReportUpload[]
  events          ReportEvent[]
  consoleLogs     ConsoleLogEntry[]
  networkRequests NetworkRequestEntry[]
  comments        ReportComment[]
  assignees       ReportAssignee[]
  captureSessions CaptureSession[]
  pageActions     PageActionEntry[]
  runtimeErrors   RuntimeErrorEntry[]
  performanceEntries PerformanceEntry[]
  domEvents       DomEventEntry[]
  backendTraces   BackendTraceEntry[]

  @@index([workspaceId, boardColumn, boardOrder, createdAt])
  @@index([workspaceId, projectId, status, createdAt])
  @@index([shareToken])
  @@map("bug_reports")
}

model ReportAssignee {
  id           String   @id @default(cuid())
  reportId     String
  workspaceId  String
  userId       String
  assignedById String?
  createdAt    DateTime @default(now())

  report     BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("ReportAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([reportId, userId])
  @@index([workspaceId, userId])
  @@index([reportId, createdAt])
  @@map("report_assignees")
}

model ReportBoardColumn {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  title       String
  description String?
  color       String   @default("primary")
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
  @@map("report_board_columns")
}

model CaptureSession {
  id                  String               @id @default(cuid())
  reportId            String
  status              CaptureSessionStatus @default(STARTED)
  startedAt           DateTime
  endedAt             DateTime?
  durationMs          Int?
  recordingStartedAt  DateTime?
  recordingEndedAt    DateTime?
  pageUrl             String?
  referrer            String?
  title               String?
  timezone            String?
  locale              String?
  userAgent           String?
  browserName         String?
  browserVersion      String?
  osName              String?
  extensionVersion    String?
  manifestVersion     String?
  tabId               String?
  windowId            String?
  viewportWidth       Int?
  viewportHeight      Int?
  screenWidth         Int?
  screenHeight        Int?
  devicePixelRatio    Float?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  report             BugReport             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  pageActions        PageActionEntry[]
  runtimeErrors      RuntimeErrorEntry[]
  performanceEntries PerformanceEntry[]
  domEvents          DomEventEntry[]
  backendTraces      BackendTraceEntry[]
  consoleLogs        ConsoleLogEntry[]
  networkRequests    NetworkRequestEntry[]

  @@index([reportId, status, startedAt])
  @@map("capture_sessions")
}

model ReportComment {
  id          String   @id @default(cuid())
  reportId    String
  authorId    String?
  authorName  String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("report_comments")
}

model ReportUpload {
  id            String       @id @default(cuid())
  reportId      String
  kind          UploadKind
  status        UploadStatus @default(PENDING)
  bucket        String
  objectKey     String       @unique
  contentType   String
  byteSize      BigInt?
  checksumSha256 String?
  uploadSession String?
  metadata      Json?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, kind, status])
  @@map("report_uploads")
}

model PageActionEntry {
  id            String          @id @default(cuid())
  reportId      String
  sessionId     String?
  kind          PageActionKind
  selector      String?
  nodePath      String?
  label         String?
  tagName       String?
  textPreview   String?
  valuePreview  String?
  pageUrl       String?
  x             Int?
  y             Int?
  scrollX       Int?
  scrollY       Int?
  offsetMs      Int?
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime        @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, occurredAt])
  @@index([sessionId, offsetMs])
  @@map("page_action_entries")
}

model RuntimeErrorEntry {
  id             String           @id @default(cuid())
  reportId       String
  sessionId      String?
  kind           RuntimeErrorKind
  message        String
  sourceUrl      String?
  lineNumber     Int?
  columnNumber   Int?
  stack          String?
  componentStack String?
  pageUrl        String?
  offsetMs       Int?
  occurredAt     DateTime
  metadata       Json?
  createdAt      DateTime         @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, kind, occurredAt])
  @@index([sessionId, offsetMs])
  @@map("runtime_error_entries")
}

model PerformanceEntry {
  id            String               @id @default(cuid())
  reportId      String
  sessionId     String?
  kind          PerformanceEntryKind
  name          String
  value         Float?
  startTimeMs   Float?
  durationMs    Float?
  rating        String?
  initiatorType String?
  pageUrl       String?
  offsetMs      Int?
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime             @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, kind, occurredAt])
  @@index([sessionId, offsetMs])
  @@map("performance_entries")
}

model DomEventEntry {
  id            String       @id @default(cuid())
  reportId      String
  sessionId     String?
  kind          DomEventKind
  selector      String?
  nodePath      String?
  mutationType  String?
  previousValue String?
  nextValue     String?
  pageUrl       String?
  offsetMs      Int?
  occurredAt    DateTime
  attributes    Json?
  metadata      Json?
  createdAt     DateTime     @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, kind, occurredAt])
  @@index([sessionId, offsetMs])
  @@map("dom_event_entries")
}

model BackendTraceEntry {
  id            String             @id @default(cuid())
  reportId      String
  sessionId     String?
  traceId       String?
  spanId        String?
  parentSpanId  String?
  serviceName   String?
  operationName String
  status        BackendTraceStatus @default(UNKNOWN)
  method        String?
  url           String?
  statusCode    Int?
  durationMs    Float?
  startedAt     DateTime
  endedAt       DateTime?
  offsetMs      Int?
  metadata      Json?
  createdAt     DateTime           @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, status, startedAt])
  @@index([traceId])
  @@index([sessionId, offsetMs])
  @@map("backend_trace_entries")
}

model ReportEvent {
  id        String          @id @default(cuid())
  reportId  String
  kind      ReportEventKind
  payload   Json?
  createdAt DateTime        @default(now())

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, kind, createdAt])
  @@map("report_events")
}

model ConsoleLogEntry {
  id        String          @id @default(cuid())
  reportId  String
  sessionId String?
  level     ConsoleLogLevel
  message   String
  args      Json?
  stack     String?
  pageUrl   String?
  offsetMs  Int?
  timestamp DateTime
  createdAt DateTime        @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, level, timestamp])
  @@index([sessionId, offsetMs])
  @@map("console_log_entries")
}

model NetworkRequestEntry {
  id              String   @id @default(cuid())
  reportId        String
  sessionId       String?
  requestId       String?
  method          String
  url             String
  statusCode      Int?
  durationMs      Int?
  requestHeaders  Json?
  responseHeaders Json?
  requestBody     String?
  responseBody    String?
  error           String?
  // Chrome's own webRequest ResourceType ("image", "script", "stylesheet",
  // "font", "main_frame", ...) for browser-observed resource loads, or
  // "fetch"/"xhr" for requests captured via the page-bridge's API patches.
  // Null on rows captured before this field existed.
  resourceType    String?
  offsetMs        Int?
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  report  BugReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  session CaptureSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([reportId, method, statusCode, startedAt])
  @@index([sessionId, offsetMs])
  @@map("network_request_entries")
}

NODE_ENV=development
API_PORT=4000
APP_NAME=weevil
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weevil
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_RECORDINGS=weevil-recordings
PUBLIC_ASSET_URL=
ENABLE_CORS=true
ENABLE_CSRF=true
WEB_ORIGIN=http://localhost:3000
# Comma-separated extension origins. Keep old IDs during rollout, add the new
# Chrome Web Store ID when production changes it.
EXTENSION_ORIGINS=chrome-extension://dev-extension-id,chrome-extension://prod-extension-id
WEB_APP_URL=http://localhost:3000
AUTH_OTP_SECRET=dev-only-change-me-to-at-least-32-characters
AUTH_GOOGLE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three FIREBASE_* fields above: raw JSON or base64 JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Preferred in production containers: mount the JSON file read-only and point here.
FIREBASE_SERVICE_ACCOUNT_PATH=
NOTIFICATION_GATEWAY_URL=http://localhost:9111
NOTIFICATION_GATEWAY_API_KEY=
NOTIFICATION_GATEWAY_TIMEOUT_MS=5000

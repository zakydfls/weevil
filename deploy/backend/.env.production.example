NODE_ENV=production
APP_NAME=weevil
API_PORT=4000

# Filled by deploy.sh in the VPS .env with the exact backend image SHA. Keeping
# it there lets plain `docker compose -f compose.prod.yml up -d` reload env changes.
# If absent, compose falls back to ghcr.io/zakydfls/weevil/backend:main.
# WEEVIL_BACKEND_IMAGE=ghcr.io/zakydfls/weevil/backend:sha-...

# If Postgres/Redis/RabbitMQ/MinIO run directly on the host, use
# host.docker.internal from the backend containers. If they run in another
# Docker network, use the service DNS name instead.
DATABASE_URL=postgresql://weevil:change-me@host.docker.internal:5432/weevil

# Supabase note:
# If your VPS/container cannot reach db.<project-ref>.supabase.co:5432,
# use the IPv4-compatible Session Pooler from Supabase Dashboard -> Connect.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

REDIS_URL=redis://host.docker.internal:6379
RABBITMQ_URL=amqp://weevil:change-me@host.docker.internal:5672

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false
MINIO_BUCKET_RECORDINGS=weevil-recordings

# Optional public URL used by StorageService when object URLs should be built
# from a reverse-proxied asset host instead of MinIO presigned URLs.
PUBLIC_ASSET_URL=

# Comma-separated allowed frontend origins. Include your production custom
# domain and, if needed, the Vercel production domain.
WEB_ORIGIN=https://weevil.example.com,https://weevil.vercel.app
WEB_APP_URL=https://weevil.example.com

# Required in production. Generate with:
# openssl rand -base64 48
AUTH_OTP_SECRET=change-me-with-a-long-random-secret-at-least-32-chars

# Century Notification Gateway used for workspace invitation emails.
NOTIFICATION_GATEWAY_URL=https://notif.example.com
NOTIFICATION_GATEWAY_API_KEY=change-me
NOTIFICATION_GATEWAY_TIMEOUT_MS=5000

# For Vercel frontend + VPS API on different sites, cookies must be
# SameSite=None and Secure=true. Keep DOMAIN empty unless sharing cookies across
# subdomains like app.example.com and api.example.com.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

PRISMA_LOG=off

# Production seeder. RUN_PROD_SEED is read by deploy.sh from this file unless
# a GitHub Actions variable with the same name overrides it.
RUN_PROD_SEED=false
SEED_ADMIN_EMAIL=zaky.d@triquetra.cc
SEED_ADMIN_PASSWORD=change-this-long-password
SEED_ADMIN_NAME=Zaky Daffa
SEED_WORKSPACE_SLUG=triquetra
SEED_WORKSPACE_NAME=Triquetra
SEED_PROJECT_KEY=BUG
SEED_PROJECT_NAME=Bugs

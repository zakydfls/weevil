NODE_ENV=production
API_PORT=4000

# If Postgres/Redis/RabbitMQ/MinIO run directly on the host, use
# host.docker.internal from the backend containers. If they run in another
# Docker network, use the service DNS name instead.
DATABASE_URL=postgresql://weevil:change-me@host.docker.internal:5432/weevil
REDIS_URL=redis://host.docker.internal:6379
RABBITMQ_URL=amqp://weevil:change-me@host.docker.internal:5672

MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false
MINIO_BUCKET_RECORDINGS=weevil-recordings

# Optional public URL used by StorageService when object URLs should be built
# from a reverse-proxied asset host instead of MinIO presigned URLs.
PUBLIC_ASSET_URL=

# Comma-separated allowed frontend origins. Include your production custom
# domain and, if needed, the Vercel production domain.
WEB_ORIGIN=https://weevil.example.com,https://weevil.vercel.app

# For Vercel frontend + homeserver API on different sites, cookies must be
# SameSite=None and Secure=true. Keep DOMAIN empty unless sharing cookies across
# subdomains like app.example.com and api.example.com.
COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

PRISMA_LOG=off

# Production seeder. Required only when RUN_PROD_SEED=true in GitHub Actions
# variables or when running the seed service manually.
SEED_ADMIN_EMAIL=zaky.d@triquetra.cc
SEED_ADMIN_PASSWORD=change-this-long-password
SEED_ADMIN_NAME=Zaky Daffa
SEED_WORKSPACE_SLUG=triquetra
SEED_WORKSPACE_NAME=Triquetra
SEED_PROJECT_KEY=BUG
SEED_PROJECT_NAME=Bugs
